        <mxCell id="1" parent="0" />
        <mxCell id="titulo" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A1A;" value="&lt;b style=&quot;font-size:24px&quot;&gt;Actividad 3 &amp;#183; Entregable 3.1 (A) &amp;#8212; AS-IS: lo que sale o cambia de responsabilidad&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Recorte del dise&amp;#241;o actual del Reto 1. Solo aparecen los elementos afectados por Factory Method, Strategy y Observer.&lt;br&gt;&lt;b&gt;No se muestran las clases ni interfaces nuevas del TO-BE.&lt;/b&gt;&lt;br&gt;Todos los nombres y relaciones est&amp;#225;n verificados contra el c&amp;#243;digo de &lt;i&gt;codigo/farmacia-codigo-final&lt;/i&gt;.&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="1120" x="40" y="40" as="geometry" />
