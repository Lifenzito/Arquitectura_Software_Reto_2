        <mxCell id="bandaAt" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0B4A80;" value="&lt;b style=&quot;font-size:17px&quot;&gt;1 &amp;#183; FACTORY METHOD&lt;/b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&amp;#160;&amp;#8212; creaci&amp;#243;n de objetos (puntos de dolor P-01 y P-02)&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="1200" x="70" y="350" as="geometry" />
        </mxCell>
        <mxCell id="A2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;spacing=6;" value="&lt;i style=&quot;font-size:10px&quot;&gt;&amp;#171;interface&amp;#187;&lt;/i&gt;&lt;br&gt;&lt;b&gt;IProductoFactory&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;+ Tipo: string&lt;br&gt;+ Crear(datos: string[]): Producto&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i style=&quot;font-size:10px;color:#9A5000&quot;&gt;&amp;#9662; Se reutiliza (no se duplica) pero cambia: pierde el atributo Tipo, pasa a gen&amp;#233;rica IProductoFactory&amp;lt;T&amp;gt; y Crear() recibe un diccionario en vez de string[]&lt;/i&gt;" vertex="1">
          <mxGeometry height="130" width="340" x="70" y="400" as="geometry" />
        </mxCell>
        <mxCell id="A3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#D79B00;verticalAlign=top;align=left;spacing=6;" value="&lt;b style=&quot;font-size:11px&quot;&gt;F&amp;#225;bricas concretas de producto (7) &amp;#8212; las 7 implementan IProductoFactory&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px;color:#9A5000&quot;&gt;&amp;#9662; Cada una repite el parseo de string[] (posiciones y conversiones) y construye su Proveedor: esa responsabilidad sale (P-02)&lt;/i&gt;" vertex="1">
          <mxGeometry height="210" width="1040" x="70" y="610" as="geometry" />
        </mxCell>
        <mxCell id="A3a" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" value="MedicamentoCapsulaFactory" vertex="1">
