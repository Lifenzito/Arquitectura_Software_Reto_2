  <diagram name="3.1A AS-IS cambios" id="asis-cambios">
    <mxGraphModel dx="1414" dy="743" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="3220" math="0" shadow="0">
      <root>
