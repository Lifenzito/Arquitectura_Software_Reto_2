        <mxCell id="A3g" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" value="CambioVendajeFactory" vertex="1">
          <mxGeometry height="60" width="230" x="610" y="750" as="geometry" />
        </mxCell>
        <mxCell id="A4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;spacing=6;" value="&lt;b&gt;RepositoryProducto&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;- fabricas: List&amp;lt;IProductoFactory&amp;gt;&lt;br&gt;+ CargarDesdeArchivo(ruta): string&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i style=&quot;font-size:10px;color:#9A5000&quot;&gt;&amp;#9662; Pierde la selecci&amp;#243;n de f&amp;#225;brica fabricas.First(f =&amp;gt; f.Tipo == tipo) y el tipo por defecto cuando faltan columnas (P-02)&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="380" x="1200" y="630" as="geometry" />
        </mxCell>
        <mxCell id="A5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;spacing=6;" value="&lt;b&gt;ClienteRepository&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;- clientes: List&amp;lt;Cliente&amp;gt;&lt;br&gt;+ Cargar(ruta): string&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i style=&quot;font-size:10px;color:#9A5000&quot;&gt;&amp;#9662; Construye el Cliente dentro de Cargar(): esa creaci&amp;#243;n sale del repositorio hacia una f&amp;#225;brica de Cliente&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="80" y="890" as="geometry" />
        </mxCell>
        <mxCell id="A6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;spacing=6;" value="&lt;b&gt;RepositoryUsuario&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;- usuarios: List&amp;lt;Usuario&amp;gt;&lt;br&gt;+ Cargar(ruta): string&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i style=&quot;font-size:10px;color:#9A5000&quot;&gt;&amp;#9662; Construye el Usuario dentro de Cargar(): esa creaci&amp;#243;n sale del repositorio hacia una f&amp;#225;brica de Usuario&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="520" y="890" as="geometry" />
        </mxCell>
        <mxCell id="A7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#000000;spacing=6;" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;hereda de Persona&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;+ UserName: string&lt;br&gt;+ Password: string&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i style=&quot;font-size:10px;color:#444444&quot;&gt;&amp;#9662; La clase no cambia; solo cambia qui&amp;#233;n la construye&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="300" x="960" y="900" as="geometry" />
        </mxCell>
        <mxCell id="bandaBt" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontColor=#4B2A80;" value="&lt;b style=&quot;font-size:17px&quot;&gt;2 &amp;#183; STRATEGY&lt;/b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&amp;#160;&amp;#8212; selecci&amp;#243;n de la regla de convenio (punto de dolor P-05)&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="1200" x="70" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="B1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;spacing=6;" value="&lt;b&gt;ServicioDescuento&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;- convenios: List&amp;lt;IEntidadConvenio&amp;gt;&lt;br&gt;+ CalcularDescuento(precio, cliente): decimal&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i style=&quot;font-size:10px;color:#9A5000&quot;&gt;&amp;#9662; Context de Strategy: se conserva, pero deja de buscar el convenio (FirstOrDefault + AplicaA) y pasa a delegar en la estrategia que trae el Cliente&lt;/i&gt;" vertex="1">
          <mxGeometry height="180" width="380" x="560" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="B2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;spacing=6;" value="&lt;i style=&quot;font-size:10px&quot;&gt;&amp;#171;interface&amp;#187;&lt;/i&gt;&lt;br&gt;&lt;b&gt;IEntidadConvenio&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;+ TipoBeneficio: TipoBeneficio&lt;br&gt;+ CalcularBeneficio(precio): decimal&lt;br&gt;+ AplicaA(cliente): bool&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i style=&quot;font-size:10px;color:#9A5000&quot;&gt;&amp;#9662; Abstracci&amp;#243;n de convenio de hoy, implementada solo por Convenio; en el TO-BE el papel de Strategy lo cumple IConvenio&lt;/i&gt;" vertex="1">
          <mxGeometry height="180" width="340" x="1020" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="B3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F8CECC;strokeColor=#B85450;spacing=6;" value="&lt;i style=&quot;font-size:10px&quot;&gt;&amp;#171;enum&amp;#187;&lt;/i&gt;&lt;br&gt;&lt;b&gt;TipoConvenio&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Empresa, Banco, Cooperativa,&lt;br&gt;Mutual, Universidad&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i style=&quot;font-size:10px;color:#A02A24&quot;&gt;&amp;#9662; Sale: sin clase base ni discriminador, ning&amp;#250;n colaborador lo consulta&lt;/i&gt;" vertex="1">
          <mxGeometry height="160" width="300" x="1480" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="B4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;spacing=6;" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;hereda de Persona&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;+ Puntos: int&lt;br&gt;+ Convenio: Convenio?&lt;br&gt;+ AcumularPuntos(puntos): void&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i style=&quot;font-size: 10px; color: rgb(154, 80, 0);&quot;&gt;▾ El campo Convenio apunta a la clase concreta; pasa a ser de tipo IConvenio&lt;/i&gt;" vertex="1">
          <mxGeometry height="200" width="340" x="80" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="B5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F8CECC;strokeColor=#B85450;spacing=6;" value="&lt;b&gt;Convenio&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;+ NombreEntidad: string&lt;br&gt;+ TipoConvenio: TipoConvenio&lt;br&gt;+ ObtenerPorcentaje(): decimal&lt;br&gt;+ virtual CalcularBeneficio(precio): decimal&lt;br&gt;+ virtual AplicaA(cliente): bool&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i style=&quot;font-size:10px;color:#A02A24&quot;&gt;&amp;#9662; Sale: desaparece la clase. Su c&amp;#225;lculo, la lectura de convenios.txt y AplicaA() se reparten entre los convenios concretos (P-05)&lt;/i&gt;" vertex="1">
          <mxGeometry height="210" width="340" x="1020" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="B6" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#000000;spacing=6;" value="&lt;b&gt;convenios.txt&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Porcentaje por TipoConvenio&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i style=&quot;font-size:10px;color:#444444&quot;&gt;&amp;#9662; Se conserva, pero hoy se indexa por TipoConvenio, que sale: su clave queda por decidir en el TO-BE&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="300" x="1480" y="1590" as="geometry" />
        </mxCell>
        <mxCell id="B8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#D79B00;verticalAlign=top;align=left;spacing=6;" value="&lt;b style=&quot;font-size:11px&quot;&gt;Convenios concretos (5) &amp;#8212; hoy subclases vac&amp;#237;as de Convenio&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px;color:#9A5000&quot;&gt;&amp;#9662; Dejan de heredar de Convenio y de ser cascarones: pasan a implementar IConvenio, cada uno con su propia regla de descuento (P-05)&lt;/i&gt;" vertex="1">
          <mxGeometry height="210" width="860" x="980" y="1840" as="geometry" />
        </mxCell>
        <mxCell id="B8a" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" value="&lt;b&gt;ConvenioEmpresa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;solo fija TipoConvenio.Empresa&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="250" x="1010" y="1900" as="geometry" />
        </mxCell>
        <mxCell id="B8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" value="&lt;b&gt;ConvenioBanco&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;solo fija TipoConvenio.Banco&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="250" x="1290" y="1900" as="geometry" />
        </mxCell>
        <mxCell id="B8c" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" value="&lt;b&gt;ConvenioCooperativa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;solo fija TipoConvenio.Cooperativa&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="250" x="1570" y="1900" as="geometry" />
        </mxCell>
        <mxCell id="B8d" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" value="&lt;b&gt;ConvenioMutual&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;solo fija TipoConvenio.Mutual&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="250" x="1010" y="1980" as="geometry" />
        </mxCell>
        <mxCell id="B8e" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" value="&lt;b&gt;ConvenioUniversidad&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;solo fija TipoConvenio.Universidad&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="250" x="1290" y="1980" as="geometry" />
        </mxCell>
        <mxCell id="bandaCt" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontColor=#1A6B45;" value="&lt;b style=&quot;font-size:17px&quot;&gt;3 &amp;#183; OBSERVER&lt;/b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&amp;#160;&amp;#8212; sistema de eventos (puntos de dolor P-08 y P-09)&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="1200" x="70" y="2210" as="geometry" />
        </mxCell>
        <mxCell id="C2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;spacing=6;" value="&lt;b&gt;ServicioCliente&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;+ EventoPuntos: EventoPuntos&lt;br&gt;&amp;#160;&amp;#160;&lt;i&gt;(campo p&amp;#250;blico)&lt;/i&gt;&lt;br&gt;ctor: EventoPuntos = new EventoPuntos()&lt;br&gt;+ AcumularPuntos(cliente, puntos)&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i style=&quot;font-size:10px;color:#9A5000&quot;&gt;&amp;#9662; Deja de crear y de exponer un evento concreto&lt;/i&gt;" vertex="1">
